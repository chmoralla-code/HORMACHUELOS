{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "outDir": "../dist",
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src-tauri/**", "dist/**", "node_modules/**"]
}